NODE_ENV=development
PORT=4000
# Local development uses MongoDB on this machine.
# For Netlify, use a MongoDB Atlas SRV URI in the AWS Mumbai region (ap-south-1).
MONGODB_URI=mongodb://127.0.0.1:27017/markex_crm
CLIENT_ORIGIN=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173
TRUST_PROXY=false

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
WEBHOOK_SECRET=

# Created on first boot only when no users exist. Use a unique password of at least 10 characters.
ADMIN_EMAIL=
ADMIN_NAME=MARKEX Admin
ADMIN_PASSWORD=

# Transactional email. Leave blank until the sender is verified with the provider.
# Gmail display form: MARKEX Trading Academy <markexacademy@gmail.com>
# Recommended later provider, only after approval: a domain-authenticated sender. Do not put secrets here.
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=

# Or send with Gmail. Use a Google app password, not the account password. Leave blank to keep mail queued.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional Google Sheets synchronization. Share the response spreadsheet with this service account.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional error sink. Receives sanitized JSON error reports.
ERROR_WEBHOOK_URL=

# Set to false to disable the built-in job worker (tests do this).
DISABLE_JOB_WORKER=false
